# --- Pipeline output (generated; never commit) ---
#
# CAREFUL: .gitignore has NO inline-comment syntax. A '#' only begins a comment
# when it is the FIRST character of a line. These four rules were written as
# "results/   # per-sample workflow outputs", which git read as a pattern
# containing spaces and a literal '#' -- matching nothing at all. None of them
# worked, which is how results/ and .snakemake/ came to be tracked. Keep every
# comment on its own line.

# per-sample workflow outputs
results/
# Snakemake's working/metadata directory
.snakemake/
# extract output written next to inputs
*_anchovy.csv
# merged consensus written next to inputs
*_allConsensus.fasta

# ...but never the committed fixtures and goldens under tests/data/, which match
# the two patterns above by name and must stay trackable.
!tests/data/*_anchovy.csv
!tests/data/*_allConsensus.fasta
!tests/data/**/*_anchovy.csv
!tests/data/**/*_allConsensus.fasta

# --- Python packaging / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Test / coverage artifacts ---
.pytest_cache/
.coverage
htmlcov/

# --- Environments ---
.venv/
venv/
env/

# --- Editor / OS cruft ---
.DS_Store
.idea/
.vscode/

# --- Test fixture outputs that get regenerated ---
# (Keep the committed golden references and input fixtures under tests/data/;
#  ignore only transient outputs a run might drop there.)
/tmp/
