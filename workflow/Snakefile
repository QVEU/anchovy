# workflow/Snakefile
#
# Snakemake workflow for the anchovy pipeline. Replaces AnchovyJob.sh.
#
# USAGE (the config file IS the interface -- you don't edit this file to run on
# your own data; you copy a config, edit its paths, and run):
#   snakemake -s workflow/Snakefile --configfile config.yaml --cores 4 -n
#   snakemake -s workflow/Snakefile --configfile config.yaml --cores 4
#
# See workflow/README.md for the config-swap pattern and examples.

import glob
import os
import shutil

# NO `configfile:` directive on purpose. It used to name workflow/config.yaml,
# which meant every run MERGED that file underneath whatever --configfile you
# passed. Harmless while your config overrode every key, but the base config
# points `whitelist` and `template` at the TEST FIXTURES -- so a config that
# omitted either silently inherited a 4-barcode whitelist instead of failing,
# and the run looked like bad data rather than a bad config.
#
# Pass --configfile explicitly, as the README and every example already do:
#   snakemake -s workflow/Snakefile --configfile workflow/config.yaml --cores 8
# A missing key is then a loud KeyError naming it.

# --------------------------------------------------------------------------- #
# The interface: a directory of FASTQs, a reference, and a region model
# --------------------------------------------------------------------------- #
# Point `input_dir` at a folder of FASTQs and every one of them is run through
# the whole pipeline -- map, extract, per-cell consensus, genotypes, networks,
# report -- with its outputs named after the FASTQ. Nothing else is required
# and no script is run by hand: `fetch.sh` now only fetches the public example
# data, and is not part of running your own.
#
# A sample's name is its FASTQ's basename with .gz/.fastq/.fq stripped, the
# same rule examples/eva71_sra/sample_name.sh uses, so the two agree.
INPUT_DIR = config.get("input_dir")
TEMPLATE  = config["template"]
if INPUT_DIR is None and "samples" not in config:
    raise WorkflowError(
        "config needs `input_dir` -- the folder holding the FASTQs to run. "
        "(Or `samples`, with `cells_dir`, to resume from per-cell FASTAs.)")

RESOURCES = config.get("resources_dir", "resources")


# Discovery lives in the package so it can be unit-tested and so there is one
# definition of what a sample is called. ValueError becomes WorkflowError here
# because that is what snakemake reports cleanly.
from anchovy.io import discover_fastqs


# `samples` names them explicitly instead of discovering them, which is what
# the `cells_dir` resume path needs: it starts from per-cell FASTAs that already
# exist, so there is no FASTQ to take a name from. Normal runs omit it and let
# the folder decide. map_reads is never requested on that path, so the empty
# FASTQS map is not reachable from it.
if "samples" in config:
    SAMPLES = sorted(config["samples"])
    FASTQS = {}
else:
    try:
        FASTQS = discover_fastqs(INPUT_DIR)
    except ValueError as exc:
        raise WorkflowError(str(exc)) from None
    SAMPLES = sorted(FASTQS)

# --------------------------------------------------------------------------- #
# 10X chemistry: one key, because the two halves must agree
# --------------------------------------------------------------------------- #
# The signature's N-run carries the layout -- a fixed 22-base handle, a 16-base
# barcode, then the UMI, whose width anchovy derives as len(signature) - 48 --
# so v2 and v3 differ only in the N count. The whitelist is NOT derived and is
# chemistry-specific, and mismatching the pair does not fail: every read is
# assigned to its nearest entry in the wrong list and the output looks ordinary.
# So `chemistry` sets both, and they cannot come apart.
CHEMISTRIES = {
    "v2": {
        "ns": 26,            # 16 nt barcode + 10 nt UMI
        "whitelist": "737K-august-2016.txt",
        "barcodes": 737280,
        # Verified reachable. The identical file ships with Cell Ranger.
        "url": ("https://raw.githubusercontent.com/10XGenomics/supernova/"
                "refs/heads/master/tenkit/lib/python/tenkit/barcodes/"
                "737K-august-2016.txt"),
    },
    "v3": {
        "ns": 28,            # 16 nt barcode + 12 nt UMI
        "whitelist": "3M-february-2018.txt",
        "barcodes": 6794880,
        # 10X does not host this one itself; this is the copy published with
        # scg_lib_structs. Served gzipped, which get_whitelist handles.
        #
        # The barcode count below is the check that matters here: it is the
        # figure for 3M-february-2018.txt, and if this mirror ever serves
        # something else the rule fails naming the count it got rather than
        # letting a wrong whitelist through. Set `whitelist_barcodes` to
        # override the expected figure, or `whitelist` to use a local copy --
        # Cell Ranger ships one at
        # cellranger-x.y.z/lib/python/cellranger/barcodes/3M-february-2018.txt.gz
        "url": ("https://teichlab.github.io/scg_lib_structs/data/"
                "10X-Genomics/3M-february-2018.txt.gz"),
    },
}

CHEMISTRY = config.get("chemistry", "v3")
if CHEMISTRY not in CHEMISTRIES:
    raise WorkflowError(
        f"unknown chemistry {CHEMISTRY!r}; expected one of "
        f"{sorted(CHEMISTRIES)}.")
CHEM = CHEMISTRIES[CHEMISTRY]

# `signature` overrides the derived one, for an assay whose handles differ from
# 10X's. The N count still has to match the whitelist.
SIGNATURE = config.get(
    "signature",
    "CTACACGACGCTCTTCCGATCT" + "N" * CHEM["ns"] + "TTTCTTATAT")

WHITELIST_URL = config.get("whitelist_url", CHEM["url"])

if "whitelist" in config:
    WHITELIST = config["whitelist"]          # a local copy, used as-is
elif WHITELIST_URL:
    WHITELIST = RESOURCES + "/" + CHEM["whitelist"]   # downloaded once, reused
else:
    raise WorkflowError(
        f"chemistry {CHEMISTRY!r} has no whitelist to download, so one has to "
        f"be supplied.\n"
        f"  Set `whitelist` to a local {CHEM['whitelist']} -- Cell Ranger ships "
        f"it at\n"
        f"    cellranger-x.y.z/lib/python/cellranger/barcodes/"
        f"{CHEM['whitelist']}.gz  (gunzip it)\n"
        f"  or set `whitelist_url` to a mirror you can reach.")

# --------------------------------------------------------------------------- #
# Reference name, read from the reference rather than asked for
# --------------------------------------------------------------------------- #
# sam2consensus prefixes its per-cell outputs with the SAM's reference name,
# which is the FASTA's own header. Asking the user to retype it just invites a
# mismatch that surfaces as missing files deep in the scatter, so read it.
def _reference_name(path):
    try:
        handle = open(path)
    except OSError as exc:
        # Reached before any job runs, so say which key is wrong rather than
        # letting a bare FileNotFoundError name a path with no context.
        raise WorkflowError(
            f"cannot read `template` ({path}): {exc.strerror}.\n"
            f"  This is the reference FASTA the reads are mapped to, and its "
            f"header supplies the reference name.") from None
    with handle:
        for line in handle:
            if line.startswith(">"):
                return line[1:].split()[0]
    raise WorkflowError(f"{path} has no FASTA header line, so the reference "
                        f"name cannot be read from it.")


REFNAME = config.get("reference_name") or _reference_name(TEMPLATE)

# SAMPLE is the wildcard, not a fixed string: every path below is built by
# concatenation, so this turns each one into a per-sample pattern without
# touching the rules.
SAMPLE  = "{sample}"
RESULTS = "results/{sample}"

ALL_CONSENSUS = RESULTS + "/" + SAMPLE + "_allConsensus.fasta"

# --------------------------------------------------------------------------- #
# Input/output location separation (clean data flow)
# --------------------------------------------------------------------------- #
# CELLS_IN  = where per-cell FASTAs are READ from.
#   - default: produced by the `fasta` checkpoint into RESULTS/cells
#   - override: set `cells_dir` in config to read PRE-EXISTING cells (for testing
#     the mapping-onward stages, or resuming from per-cell FASTAs you already have)
#
# WORK = where the workflow WRITES generated artifacts (per-cell SAMs and consensus
#   FASTAs). Always under results/, owned by the workflow, safe to delete. Never
#   writes into the input/source location, so source data stays pristine.
CELLS_IN        = config.get("cells_dir", RESULTS + "/cells")
CELLS_FROM_CKPT = "cells_dir" not in config       # True => produced by checkpoint
WORK            = RESULTS + "/work"


# --------------------------------------------------------------------------- #
# Region-aware annotation (optional)
# --------------------------------------------------------------------------- #
# Set `gff` in the config to annotate mutations against genome regions (coding
# AND non-coding) instead of assuming one ORF read in frame 1. Doing so requires
# genome coordinates, which only survive the consensus stage in whole-reference
# mode -- so `gff` implies `whole_reference`, and we derive it rather than making
# the user set two keys consistently.
#
# In whole-reference mode orf_start/orf_end stop being a cut and become an
# optional ANALYSIS WINDOW: the covered core to call variants over, excluding
# ragged flanks. Positions are never renumbered either way.
GFF        = config.get("gff")
WHOLE_REF  = bool(config.get("whole_reference", False)) or GFF is not None
ORF_START  = config.get("orf_start")
ORF_END    = config.get("orf_end")

# `window: cds` takes the analysis window from the GFF's CDS feature instead of
# hand-written coordinates. Worth having as a key rather than a note in a
# comment: the window is 0-based half-open (it indexes the consensus directly)
# while GFF3 is 1-based inclusive, so transcribing CDS bounds by hand needs an
# off-by-one on one end only -- and getting it wrong shifts which positions are
# called and which cells count as complete, silently. anchovy.regions.cds_window
# does the conversion once.
if config.get("window") == "cds":
    if ORF_START is not None or ORF_END is not None:
        raise WorkflowError(
            "config sets both `window: cds` and orf_start/orf_end. Use one: "
            "`window: cds` derives the window from the GFF's CDS, explicit "
            "coordinates override it.")
    if GFF is None:
        raise WorkflowError("`window: cds` needs a `gff` to read the CDS from.")
    from anchovy.regions import cds_window
    ORF_START, ORF_END = cds_window(GFF)
elif "window" in config:
    raise WorkflowError(
        f"unknown `window` value {config['window']!r}; the only supported "
        f"value is 'cds' (or omit it and set orf_start/orf_end).")

# --------------------------------------------------------------------------- #
# What genotypes are called AGAINST (optional but consequential)
# --------------------------------------------------------------------------- #
# Unset, the consensus stage computes its reference as the per-column consensus
# ACROSS the surviving cells. That answers "which cells differ from the crowd",
# and it needs a crowd: with one surviving cell that reference IS the cell, so
# every genotype comes out empty by construction.
#
# Set `reference` to a genome FASTA and each cell is called against that
# instead. Then a single cell can carry variants, mutations FIXED across the
# whole population are reported rather than silently absorbed into the
# reference, and positions mean the same thing between runs.
#
# Usually you want the same FASTA that `template` points at -- the one the reads
# were mapped to. A different genome would be compared position by position
# against an alignment built on another, which is why the length must match.
REFERENCE = config.get("reference")

# sam2consensus emits IUPAC ambiguity codes (R, Y, S...) where a position's
# reads disagree. Those mark uncertainty, not mutations, and by default the
# consensus stage does not turn them into genotype tokens -- otherwise two cells
# that are merely both unresolved at a position get grouped as sharing a
# variant. Set `keep_ambiguous: true` to retain them, e.g. when you are
# deliberately looking for within-cell mixed populations.
KEEP_AMBIGUOUS = bool(config.get("keep_ambiguous", False))

if not WHOLE_REF and (ORF_START is None or ORF_END is None):
    raise WorkflowError(
        "config needs orf_start and orf_end, or whole_reference: true / a gff.")

# Positional window args for the CLI; empty when whole-reference with no window.
WINDOW_ARGS     = "" if ORF_START is None or ORF_END is None else f"{ORF_START} {ORF_END}"
CONSENSUS_FLAGS = "--whole-reference" if WHOLE_REF else ""
ANNOTATE_FLAGS  = f"--gff {GFF}" if GFF else ""

# Keep each genotype's self-edge in the epistatic network. Off by default --
# Cytoscape draws them as a loop on every node and dropping them loses none.
# Set `self_edges: true` to reproduce the original R output exactly.
if config.get("self_edges", False):
    ANNOTATE_FLAGS = (ANNOTATE_FLAGS + " --self-edges").strip()

# --------------------------------------------------------------------------- #
# Allele frequencies (optional)
# --------------------------------------------------------------------------- #
# Opt-in because it makes sam2consensus write a second file per cell (the
# per-position pileup), which on a real run is one more output per barcode.
# The frequency stage answers a different question from the genotype network
# and deliberately does NOT use the network's cell subset: its denominators are
# per position, so a cell covering part of the CDS counts where it has data and
# is absent elsewhere. See src/anchovy/frequencies.py.
FREQUENCIES = bool(config.get("allele_frequencies", False))

ALLELE_FREQUENCIES = RESULTS + "/" + SAMPLE + "_alleleFrequencies.csv"
CELL_ALLELE_FREQ   = RESULTS + "/" + SAMPLE + "_cellAlleleFreq.csv"

# The rendered QC/results report. On by default: the pipeline is meant to end
# with something readable, not a directory of CSVs. Set `report: false` to skip
# it -- the only reason to, since it is what makes R a hard requirement for a
# complete run.
REPORT_RMD = config.get("report_rmd", "visualization/anchovy_report.rmd")
REPORT_ON  = bool(config.get("report", True))
REPORT     = RESULTS + "/" + SAMPLE + "_report.html"

REGION_ANNOTATIONS = RESULTS + "/" + SAMPLE + "_regionAnnotations.csv"
GENOTYPE_NODES     = RESULTS + "/" + SAMPLE + "_genotypeNodes.csv"


# --------------------------------------------------------------------------- #
# Aggregation: discover cells and build downstream target lists.
# --------------------------------------------------------------------------- #
def _discover_cells(wildcards):
    """Return the list of cell names, from checkpoint or pre-existing dir."""
    if CELLS_FROM_CKPT:
        cells_out = checkpoints.fasta.get(**wildcards).output.cells
    else:
        cells_out = CELLS_IN
    return glob_wildcards(os.path.join(cells_out, "{cell}.fa")).cell


def aggregate_cell_consensuses(wildcards):
    """Final per-cell consensus FASTAs (in WORK), one per discovered cell.

    sam2consensus output name convention (empirical):
    "{reference}__{prefix}.fasta", prefix = input SAM minus ".sam".
    """
    cells = _discover_cells(wildcards)
    # `sample` is filled too: WORK is a per-sample pattern now, and expanding
    # only `cell` would leave it as a literal brace in every returned path.
    return expand(WORK + "/" + REFNAME + "__{cell}_BC.fasta",
                  cell=cells, sample=wildcards.sample)


def aggregate_cell_counts(wildcards):
    """Per-cell pileup TSVs, one per discovered cell (frequencies stage only)."""
    cells = _discover_cells(wildcards)
    return expand(WORK + "/" + REFNAME + "__{cell}_BC_counts.tsv",
                  cell=cells, sample=wildcards.sample)


# --------------------------------------------------------------------------- #
# Default target
# --------------------------------------------------------------------------- #
# The pipeline now builds through the filtered consensus genotype table.
# Every target is expanded over the FASTQs found in input_dir, so one run
# covers the whole folder and each sample's outputs are named after its reads.
rule all:
    input:
        expand(RESULTS + "/" + SAMPLE + "_annot_v3.csv", sample=SAMPLES),
        # Region annotations are only produced (and only requested) when the
        # config supplies a GFF3.
        *(expand(REGION_ANNOTATIONS, sample=SAMPLES) if GFF else []),
        *(expand([ALLELE_FREQUENCIES, CELL_ALLELE_FREQ], sample=SAMPLES)
          if FREQUENCIES else []),
        *(expand(REPORT, sample=SAMPLES) if REPORT_ON else []),


# --------------------------------------------------------------------------- #
# Stage 1: extract  (SAM -> per-read CBC/UMI table)
# --------------------------------------------------------------------------- #
# --------------------------------------------------------------------------- #
# Stage 0a: get_whitelist  (fetch the barcode whitelist once per chemistry)
# --------------------------------------------------------------------------- #
# Downloaded rather than asked for, and shared by every sample in the run.
# Local, because it is one network call, not work to schedule on a node.
#
# THE LINE COUNT IS CHECKED AND A MISMATCH IS FATAL. The whole reason chemistry
# is a single key is that a whitelist from the wrong chemistry does not fail --
# every read is assigned to its nearest entry in it and the cells, consensus
# sequences and genotypes look ordinary. A truncated download does the same
# thing. So the file is verified before it is allowed to become the input to
# anything, and a bad one is left as .part for inspection rather than cached.
localrules: get_whitelist


rule get_whitelist:
    output:
        RESOURCES + "/" + CHEM["whitelist"],
    params:
        url=WHITELIST_URL or "",
        expected=config.get("whitelist_barcodes", CHEM["barcodes"]),
        chemistry=CHEMISTRY,
    shell:
        r"""
        set -euo pipefail
        curl -fsSL "{params.url}" -o "{output}.dl"
        # Mirrors commonly serve these gzipped; the v2 source does not.
        if gzip -t "{output}.dl" 2>/dev/null; then
            gunzip -c "{output}.dl" > "{output}.part"
        else
            mv "{output}.dl" "{output}.part"
        fi
        rm -f "{output}.dl"
        n=$(grep -c . "{output}.part" || true)
        if [ "$n" -ne {params.expected} ]; then
            echo "error: {params.chemistry} whitelist should have {params.expected} barcodes, got $n." >&2
            echo "       Left at {output}.part. A wrong or truncated whitelist does not fail the" >&2
            echo "       run -- it silently assigns every read to a nearest entry in the wrong" >&2
            echo "       list -- so it is rejected here instead." >&2
            echo "       If the file IS right and the expected figure is not, set whitelist_barcodes." >&2
            exit 1
        fi
        mv "{output}.part" "{output}"
        """


# --------------------------------------------------------------------------- #
# Stage 0b: map_reads  (FASTQ -> SAM)
# --------------------------------------------------------------------------- #
# This used to live in examples/eva71_sra/fetch.sh, which meant running your own
# data took a script AND the workflow, and the two disagreed about the sample
# name often enough to be worth a bug fix of its own. It is a pipeline stage.
#
# The SAM lands under results/, never beside the reads: input_dir is read-only
# as far as this workflow is concerned.
rule map_reads:
    input:
        fastq=lambda w: FASTQS[w.sample],
        template=TEMPLATE,
    output:
        sam=RESULTS + "/" + SAMPLE + ".sam",
    threads: config.get("map_threads", 8)
    params:
        # map-hifi for PacBio CCS, map-ont for Nanopore. Getting this wrong
        # costs alignment sensitivity rather than failing, so it is explicit.
        preset=config.get("minimap_preset", "map-hifi"),
    shell:
        "minimap2 -ax {params.preset} -t {threads} "
        "{input.template} {input.fastq} > {output.sam}"


rule extract:
    input:
        sam=RESULTS + "/" + SAMPLE + ".sam",
        whitelist=WHITELIST,
    output:
        RESULTS + "/" + SAMPLE + "_anchovy.csv",
    # extract runs its own multiprocessing Pool, which is NOT snakemake's
    # --cores: that governs how many JOBS run at once, and extract is one job.
    # Without this the pool sits at the CLI default of 16 however large the
    # node is. Declared as `threads` rather than a bare param so the scheduler
    # reserves the cores rather than oversubscribing them, and so snakemake
    # scales it down when --cores is smaller.
    threads: config.get("extract_threads", 16)
    params:
        sig=SIGNATURE,
        # How wrong the SIGNATURE match may be before a read is discarded.
        # The default of 42 is very permissive on a 58-character signature.
        max_distance=(f"--max-distance {config['max_distance']}"
                      if "max_distance" in config else ""),
        # How wrong the assigned BARCODE may be. Unset, every read that clears
        # the signature filter is assigned to its nearest whitelist entry with
        # no floor however poorly it matched, and those assignments become
        # cells, consensus sequences and genotypes indistinguishable from good
        # ones. Setting it also makes the stage far faster, because a bounded
        # search can answer "is anything within k errors" by enumerating the
        # neighbourhood instead of scanning all 737,280 entries.
        max_barcode_errors=(
            f"--max-barcode-errors {config['max_barcode_errors']}"
            if "max_barcode_errors" in config else ""),
    shell:
        "anchovy extract {input.sam} {input.whitelist} "
        "--signature {params.sig} -o {output} --threads {threads} "
        "{params.max_distance} {params.max_barcode_errors}"


# --------------------------------------------------------------------------- #
# Stage 2: fasta  (anchovy CSV -> per-cell FASTAs)  -- THE CHECKPOINT
# --------------------------------------------------------------------------- #
# `min_reads` DECIDES THE SIZE OF THE WHOLE RUN, so it is exposed here rather
# than left at the CLI default of 5. Every barcode emitted by this checkpoint
# becomes two downstream jobs (map_cell + cell_consensus), and on a cluster that
# means two scheduler submissions. The per-cell depth filter that actually
# matters for the science (`depth_min`) is applied much later, at the consensus
# stage -- so a barcode carrying 5 reads costs a full minimap2 run and a full
# sam2consensus run before being discarded for having too little coverage.
#
# On a real 10X run the barcode distribution has a very long tail of such cells.
# Raising this is the cheapest way to cut a run from hundreds of thousands of
# jobs to a tractable number, and it discards only cells that could not have
# survived `depth_min` anyway.
checkpoint fasta:
    input:
        csv=RESULTS + "/" + SAMPLE + "_anchovy.csv",
    output:
        cells=directory(RESULTS + "/cells"),
    params:
        min_reads=f"--min-reads {config['min_reads']}" if "min_reads" in config else "",
    shell:
        "anchovy fasta {input.csv} {output.cells} {params.min_reads}"


# --------------------------------------------------------------------------- #
# Stage 3: map_cell  (read one per-cell FASTA -> write one per-cell SAM to WORK)
# --------------------------------------------------------------------------- #
# BOTH PER-CELL RULES ARE IN THE GROUP "cell", which matters on a cluster.
# Without a group, every cell is two separate submissions, each doing seconds of
# work -- scheduler overhead then dominates the run and, at hundreds of
# thousands of cells, the queue itself becomes the bottleneck. Grouping keeps a
# cell's map and consensus together (the intermediate SAM never leaves the
# node), and lets you batch many cells into one submission:
#
#   snakemake -s workflow/Snakefile --configfile config.yaml \
#       --executor slurm --jobs 200 --group-components cell=200
#
# Locally the group is harmless; it just runs the pair back to back.
# Reads from CELLS_IN, writes to WORK -- input and output locations are distinct,
# so the source cells directory is never written to.
rule map_cell:
    input:
        fa=CELLS_IN + "/{cell}.fa",
        template=config["template"],
    output:
        sam=WORK + "/{cell}_BC.sam",
    group:
        "cell"
    shell:
        "minimap2 -ax map-hifi {input.template} {input.fa} > {output.sam}"


# --------------------------------------------------------------------------- #
# Stage 4: cell_consensus  (read per-cell SAM from WORK -> write consensus to WORK)
# --------------------------------------------------------------------------- #
# Runs vendored, Python-3-converted sam2consensus.py.
# OUTPUT NAMING (empirical): "{reference}__{prefix}.fasta", prefix = SAM minus .sam.
# LIMITATION (conscious): reference name hardcoded from config -> assumes a SINGLE
# reference. Multi-segment references would emit multiple files per cell.
#
# THE `touch` IS LOAD-BEARING, and this failed on real data without it.
# sam2consensus builds a dict of sequences to write, skipping any whose bases
# are all gaps, and then writes one file per entry -- so a cell where NO
# position reaches --min-depth leaves that dict empty, writes nothing at all,
# and still exits 0. Snakemake declares the file required, so a single sparse
# cell aborted the entire run with MissingOutputException.
#
# That is the normal case on real 10X data: most barcodes carry few reads. It
# never showed up on the test fixture because every fixture cell has 6 reads at
# every position, comfortably over the default min-depth of 5.
#
# Dropping a cell with too little coverage is correct -- that is what the depth
# filter is for. The bug is only that "no consensus" is signalled by an absent
# file. touch turns it into an empty one, which merge_consensus concatenates to
# nothing and parse_consensus_fasta reads as zero records, so the cell simply
# does not appear downstream.
rule cell_consensus:
    input:
        sam=WORK + "/{cell}_BC.sam",
        script="workflow/scripts/sam2consensus.py",
    output:
        fasta=WORK + "/" + REFNAME + "__{cell}_BC.fasta",
        # Same load-bearing touch as the FASTA below: a cell whose reads never
        # reach min-depth writes neither file, and snakemake requires both.
        **({"counts": WORK + "/" + REFNAME + "__{cell}_BC_counts.tsv"}
           if FREQUENCIES else {}),
    params:
        cons_threshold=config.get("cons_threshold", 0.5),
        min_depth=config.get("cons_min_depth", 5),
        outfolder=WORK,
        counts="--counts" if FREQUENCIES else "",
    group:
        "cell"
    shell:
        "python {input.script} -c {params.cons_threshold} -m {params.min_depth} "
        "{params.counts} --outfolder {params.outfolder} -i {input.sam} && "
        "touch {output}"


# --------------------------------------------------------------------------- #
# Stage 5: merge_consensus  (gather all per-cell consensuses -> one FASTA)
# --------------------------------------------------------------------------- #
# The "gather" counterpart to map_cell's "scatter". Its input is the aggregation
# function, so Snakemake won't run it until EVERY discovered cell's consensus
# exists. Concatenates them into the _allConsensus.fasta that `anchovy consensus`
# consumes. This replaces the `cat ${indir}/*.fasta > ..._allConsensus.fasta`
# line at the end of AnchovyJob.sh -- but tracked and dependency-correct.
# WHY THIS IS PYTHON AND NOT `cat {input} > {output}`.
# {input} expands to one path per cell on a single command line. A real run has
# tens or hundreds of thousands of cells, and the kernel caps a command's
# argument list (ARG_MAX, typically ~2MB) -- at roughly 60 bytes per path that
# is about 30,000 cells, past which the rule dies with "Argument list too long".
# It is a hard failure at the GATHER step, after every per-cell job has already
# run, so it wastes the entire scatter. Streaming the files in Python has no
# such limit and never materializes the list as text.
rule merge_consensus:
    input:
        aggregate_cell_consensuses,
    output:
        ALL_CONSENSUS,
    run:
        with open(output[0], "wb") as out_fh:
            for path in input:
                with open(path, "rb") as in_fh:
                    shutil.copyfileobj(in_fh, out_fh)


# --------------------------------------------------------------------------- #
# Stage 6: consensus  (allConsensus.fasta -> filtered genotype table + reference)
# --------------------------------------------------------------------------- #
# One-in-one-out rule calling the `anchovy consensus` CLI. Filters the merged
# consensuses and calls per-cell genotypes -- trimming to the ORF region in the
# default mode, or keeping the whole reference (genome coordinates) when a GFF is
# configured. See the region-aware block near the top of this file.
# Produces two outputs (the CLI derives their names from the input via
# --out-prefix): the filtered genotype CSV and the reference sequence.
rule consensus:
    input:
        fasta=ALL_CONSENSUS,
        # Declared as an input so Snakemake tracks it: change the reference and
        # the genotypes are stale, which it cannot know from a params string.
        **({"reference": REFERENCE} if REFERENCE else {}),
    output:
        csv=RESULTS + "/" + SAMPLE + "_filtConsensus.csv",
        reference=RESULTS + "/" + SAMPLE + "_consensus_reference.txt",
    params:
        window=WINDOW_ARGS,
        flags=CONSENSUS_FLAGS,
        depth_min=config.get("depth_min", 10),
        out_prefix=RESULTS + "/" + SAMPLE,
        reference=f"--reference {REFERENCE}" if REFERENCE else "",
        ambiguous="--keep-ambiguous" if KEEP_AMBIGUOUS else "",
        # Omitted entirely when unset, so the CLI sees None and leaves the
        # filter off -- passing a default here would turn it silently on.
        breadth=(f"--min-breadth {config['min_breadth']}"
                 if "min_breadth" in config else ""),
        depth_called=(f"--min-depth-called {config['min_depth_called']}"
                      if "min_depth_called" in config else ""),
    shell:
        "anchovy consensus {input.fasta} {params.window} {params.flags} "
        "--depth-min {params.depth_min} --out-prefix {params.out_prefix} "
        "{params.reference} {params.ambiguous} "
        "{params.breadth} {params.depth_called}"


# --------------------------------------------------------------------------- #
# Stage 7: annotate  (filtConsensus.csv + reference -> annotated table + networks)
# --------------------------------------------------------------------------- #
# The final analysis stage: the Python port of the R annotation. Produces the
# annotated genotype table and the genotype/epistatic network CSVs. Plotting was
# deliberately dropped (see annotate.py). This is a one-in-two-out rule (three
# outputs when networks are on).
rule annotate:
    input:
        csv=RESULTS + "/" + SAMPLE + "_filtConsensus.csv",
        reference=RESULTS + "/" + SAMPLE + "_consensus_reference.txt",
        # Tracked, not just passed as a flag: edit the region model and every
        # residue number downstream is stale, which Snakemake cannot infer from
        # a params string. Same reasoning as `reference` on the consensus rule.
        # Annotation is the last and cheapest stage, so re-running it on a
        # richer GFF costs seconds -- but only if the dependency is declared.
        **({"gff": GFF} if GFF else {}),
    output:
        annot=RESULTS + "/" + SAMPLE + "_annot_v3.csv",
        epistatic=RESULTS + "/" + SAMPLE + "_epistaticNetwork.csv",
        genotype=RESULTS + "/" + SAMPLE + "_genotypeNetwork.csv",
        # Node attributes for the two edge tables above, so Cytoscape can label
        # and size genotypes without a manual join.
        nodes=GENOTYPE_NODES,
        # The long-format per-region table exists only in region-aware mode, so
        # it is declared as an output only when a GFF3 is configured.
        **({"regions": REGION_ANNOTATIONS} if GFF else {}),
    params:
        out_prefix=RESULTS + "/" + SAMPLE,
        flags=ANNOTATE_FLAGS,
        max_mutations=(f"--max-mutations {config['max_mutations_per_cell']}"
                       if "max_mutations_per_cell" in config else ""),
    shell:
        "anchovy annotate {input.csv} {input.reference} {params.out_prefix} "
        "{params.flags} {params.max_mutations}"


# --------------------------------------------------------------------------- #
# Stage 8: frequencies  (all cells -> allele frequency tables)  -- OPTIONAL
# --------------------------------------------------------------------------- #
# Runs over EVERY mapped cell, not the filtered subset the network is built
# from. That is the point of the split: a frequency needs an honest per-position
# denominator, not a comparable genotype string, so partial cells contribute
# where they have data instead of being discarded. The filtered CSV is still an
# input -- its cells are reported as their own columns, so the subset can be
# checked for bias against the full population rather than assumed
# representative.
rule frequencies:
    input:
        fasta=ALL_CONSENSUS,
        counts=aggregate_cell_counts,
        reference=config["template"],
        subset=RESULTS + "/" + SAMPLE + "_filtConsensus.csv",
        **({"gff": GFF} if GFF else {}),
    output:
        population=ALLELE_FREQUENCIES,
        per_cell=CELL_ALLELE_FREQ,
    params:
        out_prefix=RESULTS + "/" + SAMPLE,
        counts_dir=WORK,
        refname=REFNAME,
        gff=f"--gff {GFF}" if GFF else "",
        min_alt_reads=(f"--min-alt-reads {config['min_alt_reads']}"
                       if "min_alt_reads" in config else ""),
        min_alt_freq=(f"--min-alt-freq {config['min_alt_freq']}"
                      if "min_alt_freq" in config else ""),
        min_cells=(f"--min-cells {config['min_cells_per_allele']}"
                   if "min_cells_per_allele" in config else ""),
    shell:
        "anchovy frequencies {input.fasta} --reference {input.reference} "
        "--out-prefix {params.out_prefix} --counts-dir {params.counts_dir} "
        "--reference-name {params.refname} --subset {input.subset} "
        "{params.gff} {params.min_alt_reads} {params.min_alt_freq} "
        "{params.min_cells}"


# --------------------------------------------------------------------------- #
# Stage 9: report  (a run's outputs -> one readable HTML)  -- the last stage
# --------------------------------------------------------------------------- #
# The pipeline ends with something a person reads, not a directory of CSVs.
# Rendered per sample from the same Rmd, which takes the results directory and
# the sample prefix as parameters and finds everything else itself.
#
# The consensus FASTA is declared even though annotate does not need it: the
# report's coverage panels parse the per-cell `coverage:`/`length:` headers out
# of it, and that is the only per-cell depth record the pipeline keeps.
#
# INTERMEDIATES GO TO A PER-SAMPLE DIRECTORY. rmarkdown writes its knit
# intermediates beside the input by default, so rendering the one shared Rmd
# for several samples at once has them overwrite each other's working files --
# which surfaces as an unrelated-looking knit error in whichever loses the race.
rule report:
    input:
        rmd=REPORT_RMD,
        annot=RESULTS + "/" + SAMPLE + "_annot_v3.csv",
        consensus=ALL_CONSENSUS,
        **({"regions": REGION_ANNOTATIONS} if GFF else {}),
        **({"allele": ALLELE_FREQUENCIES, "cells": CELL_ALLELE_FREQ}
           if FREQUENCIES else {}),
    output:
        html=REPORT,
    params:
        # ABSOLUTE PATHS, RESOLVED HERE RATHER THAN IN R.
        #
        # rmarkdown::render() setwd()s to the Rmd's own directory early on, and
        # R evaluates arguments lazily -- so a relative path written into the
        # render() call is resolved AFTER that setwd, against visualization/
        # instead of the run directory. It fails with "the directory does not
        # exist" naming a directory that is sitting right there, which reads
        # like a missing output rather than a resolution bug.
        #
        # Resolving them in the rule removes R's evaluation order from the
        # question entirely: by the time Rscript starts, every path is already
        # absolute and no longer depends on where anything thinks it is.
        results_dir=lambda w: os.path.abspath(f"results/{w.sample}"),
        html=lambda w: os.path.abspath(
            f"results/{w.sample}/{w.sample}_report.html"),
        tmp=lambda w: os.path.abspath(
            f"results/{w.sample}/.report_intermediates"),
        rmd=lambda w: os.path.abspath(REPORT_RMD),
        # knit_root_dir keeps chunk-relative paths meaning what they mean
        # everywhere else in the workflow: relative to the run directory.
        rundir=os.path.abspath("."),
        sample=SAMPLE,
    shell:
        "mkdir -p {params.tmp} && "
        "Rscript -e 'rmarkdown::render("
        "\"{params.rmd}\", "
        "output_file = \"{params.html}\", "
        "intermediates_dir = \"{params.tmp}\", "
        "knit_root_dir = \"{params.rundir}\", "
        "params = list(results_dir = \"{params.results_dir}\", "
        "sample = \"{params.sample}\"), "
        "quiet = TRUE)'"
